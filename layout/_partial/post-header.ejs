
<% if(is_post() && ('words' in page) && page.words != null) {%>
    <div class="index-header-line" >
        <div id="hiddenHeaderContentArray" style="display: none;">
            <% var headerContentArray = page.words %>
            <% var headerContentArrayLength = headerContentArray.length %>
            <% for(let i = 0; i < headerContentArrayLength; i++) { %>
                <span><%= page.words[i] %></span>
            <% } %>
        </div>
        <span id="targetSpan"></span>
    </div>
<% } %>

<%
// 获取CDN开关配置
var cdnEnabled = is_cdn_enabled();
%>

<div class="header">
    <div class="header-container">
        <style>
            .header-img {
                width: 56px;
                height: auto;
                object-fit: cover; /* 保持图片比例 */
                transition: transform 0.3s ease-in-out; 
                border-radius: <%= theme.isRoundedAvatar ? '50%' : '0' %>; 
            }
            <% if (theme.isAvatarRotating && theme.isRoundedAvatar) { %>
            .header-img:hover {
                animation: rotateAnimation 2s linear infinite; /* 悬停旋转动画 */
            }
            @keyframes rotateAnimation {
                0% {
                    transform: rotate(0deg);
                }
                100% {
                    transform: rotate(360deg);
                }
            }
            <% } %>
        </style>
        <img no-lazy
            alt="^-^" 
            cache-control="max-age=86400" 
            class="header-img" 
            <% if (cdnEnabled) { %>
                src="<%- cdn_theme_url(theme.favicon) %>" 
            <% } else { %>
                src="<%- url_for(theme.favicon) %>" 
            <% } %>
        />
        <div class="header-content">
            <a class="logo" href="<%- url_for() %>"><%= config.title %></a> 
            <span class="description"><%= config.description %></span> 
        </div>
    </div>
    
   
    <ul class="nav">
        <% for (name in theme.menu) { %>
            <% 
                // 菜单链接，例如 "/list/"
                let menuLink = theme.menu[name];
                // 提取菜单路径段，去掉首尾斜杠
                let menuSeg = menuLink.substring(1, menuLink.length - 1);

                // 当前浏览器页面path，如 list/index.html 或 /posts/104e1f98/index.html
                let currentSeg = path.substring(0, path.indexOf("/"));

                // 如果菜单是 list，那么只要当前页面是 list 或者 posts，都命中高亮
                let isActive = false;
                if (menuSeg === "list") {
                    // list菜单：匹配 /list/ 页面，以及所有posts文章详情页
                    isActive = (currentSeg === "list" || currentSeg === "posts");
                } else {
                    // 其他菜单保持原来逻辑
                    isActive = (menuSeg === currentSeg);
                }
            %>
            <% if(isActive) { %>
                <li><i>
                    <% if(theme.color.enable) { %>
                        <u>
                            <a  href="<%- url_for(theme.menu[name]) %>"><%= name %></a>
                        </u>
                    <% } else { %>
                        <a style="color: #4e7dde;" href="<%- url_for(theme.menu[name]) %>"><%= name %></a>
                    <% } %>
                </i></li>
            <%} else {%>
                <li><a href="<%- url_for(theme.menu[name]) %>"><%= name %></a></li>
            <% } %>
        <% } %>
        <!-- 暂时注释掉，还需要调整css <% if(path == "list/index.html") { %>
        <li class="search">
            <input type="text" id="search-input" placeholder="搜索文章..." />
            <div id="search-results"></div>
        </li>
        <% } %> -->
    </ul>
</div>